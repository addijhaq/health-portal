{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/phenoml" },
    { "path": "packages/hl7-engine" },
    { "path": "packages/emr-connectors" },
    { "path": "packages/bots" }
  ],
  "exclude": ["node_modules", "dist"]
}
